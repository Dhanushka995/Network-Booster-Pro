<Window x:Class="NetworkBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Booster Pro" Height="250" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Local Proxy Controller" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20" 
                       HorizontalAlignment="Center"/>
            
            <Button x:Name="BtnStartStop" 
                    Content="START" 
                    Width="150" 
                    Height="40" 
                    FontSize="14" 
                    FontWeight="Bold" 
                    Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
