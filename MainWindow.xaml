<Window x:Class="NetworkBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Booster Pro" Height="450" Width="370"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A"
        StateChanged="Window_StateChanged" Closing="Window_Closing">

    <Border Background="#0F172A" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="⚡" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Network Booster Pro" FontSize="20" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Status Label -->
            <TextBlock Grid.Row="1" Text="STATUS"
                       Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="2,0,0,6"/>

            <!-- Status Text -->
            <TextBlock Grid.Row="2" x:Name="StatusText" Text="Status: Ready"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       FontWeight="SemiBold" Foreground="#64748B" FontSize="12"/>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="3" x:Name="LoadIndicator" Height="3"
                         IsIndeterminate="True" Visibility="Hidden"
                         Margin="0,0,0,20" Foreground="#3B82F6" Background="#1E293B"/>

            <!-- Action Button -->
            <Button Grid.Row="4" x:Name="ActionBtn" Content="START"
                    Height="52" FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#16A34A"
                    BorderThickness="0" Cursor="Hand" Click="ActionBtn_Click" Margin="0,0,0,20">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Data Sent Counter -->
            <TextBlock Grid.Row="5" x:Name="BytesLabel"
                       Text="Data Sent: —"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold"/>

            <!-- Auto-Start Checkbox -->
            <CheckBox Grid.Row="6" x:Name="AutoStartCheckBox"
                      Content="Run at Windows Startup"
                      HorizontalAlignment="Center" FontSize="12"
                      Foreground="#94A3B8" Click="AutoStartCheckBox_Click"/>
        </Grid>
    </Border>
</Window>
