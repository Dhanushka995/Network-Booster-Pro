<Window x:Class="NetworkBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Booster Pro" Height="380" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Network Booster Pro" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

        <TextBlock Grid.Row="1" Text="Target Host:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#34495E"/>
        <TextBox Grid.Row="2" x:Name="HostTextBox" Text="oneapp.hutch.lk" Height="30" VerticalContentAlignment="Center" Padding="5,0,0,0" FontSize="14" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Text="Ping Interval:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#34495E"/>
        <ComboBox Grid.Row="4" x:Name="IntervalComboBox" Height="30" VerticalContentAlignment="Center" Padding="5,0,0,0" FontSize="14" Margin="0,0,0,25">
            <ComboBoxItem Content="Every 5 Seconds"/>
            <ComboBoxItem Content="Every 10 Seconds" IsSelected="True"/>
            <ComboBoxItem Content="Every 15 Seconds"/>
        </ComboBox>

        <Button Grid.Row="5" x:Name="ActionBtn" Content="START" Height="45" FontSize="16" FontWeight="Bold" Foreground="White" Background="#27AE60" BorderThickness="0" Cursor="Hand" Click="ActionBtn_Click"/>

        <TextBlock Grid.Row="6" x:Name="StatusText" Text="Status: Disconnected" HorizontalAlignment="Center" Margin="0,15,0,20" FontWeight="SemiBold" Foreground="#7F8C8D"/>

        <CheckBox Grid.Row="7" x:Name="AutoStartCheckBox" Content="Run at Windows Startup" HorizontalAlignment="Center" FontWeight="Medium" Foreground="#34495E" Click="AutoStartCheckBox_Click"/>
    </Grid>
</Window>
