<Window x:Class="NetworkBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Booster Pro" Height="520" Width="370"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A"
        StateChanged="Window_StateChanged" Closing="Window_Closing">

    <Border Background="#0F172A" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Title ══ -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="⚡" FontSize="22" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="Network Booster Pro" FontSize="20"
                           FontWeight="Bold" Foreground="#E2E8F0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ══ Host Label ══ -->
            <TextBlock Grid.Row="1" Text="TARGET HOST"
                       Foreground="#64748B" FontSize="10" FontWeight="Bold"
                       Margin="2,0,0,6"/>

            <!-- ══ Host TextBox ══ -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="8"
                    BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                <TextBox x:Name="HostTextBox" Text="oneapp.hutch.lk"
                         Height="38" VerticalContentAlignment="Center"
                         Padding="12,0" FontSize="14"
                         Background="Transparent" Foreground="#E2E8F0"
                         BorderThickness="0" CaretBrush="#60A5FA"
                         SelectionBrush="#3B82F6"/>
            </Border>

            <!-- ══ Interval Label ══ -->
            <TextBlock Grid.Row="3" Text="KEEP-ALIVE INTERVAL"
                       Foreground="#64748B" FontSize="10" FontWeight="Bold"
                       Margin="2,0,0,6"/>

            <!-- ══ Interval ComboBox ══ -->
            <Border Grid.Row="4" Background="#1E293B" CornerRadius="8"
                    BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,20">
                <ComboBox x:Name="IntervalCombo" Height="38"
                          Background="Transparent" Foreground="#E2E8F0"
                          BorderThickness="0" FontSize="13" SelectedIndex="1"
                          Padding="8,0">
                    <ComboBoxItem Content="Every 5 Seconds"/>
                    <ComboBoxItem Content="Every 10 Seconds"/>
                    <ComboBoxItem Content="Every 15 Seconds"/>
                    <ComboBoxItem Content="Every 30 Seconds"/>
                </ComboBox>
            </Border>

            <!-- ══ Progress Bar (animated when active) ══ -->
            <ProgressBar Grid.Row="5" x:Name="LoadIndicator" Height="3"
                         IsIndeterminate="True" Visibility="Hidden"
                         Margin="0,0,0,16"
                         Foreground="#3B82F6" Background="#1E293B"
                         BorderThickness="0"/>

            <!-- ══ Action Button ══ -->
            <Button Grid.Row="6" x:Name="ActionBtn" Content="START"
                    Height="52" FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#16A34A"
                    BorderThickness="0" Cursor="Hand"
                    Click="ActionBtn_Click" Margin="0,0,0,16">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ══ Status Text ══ -->
            <TextBlock Grid.Row="7" x:Name="StatusText"
                       Text="Status: Ready"
                       HorizontalAlignment="Center" Margin="0,0,0,6"
                       FontWeight="SemiBold" Foreground="#64748B"
                       FontSize="12"/>

            <!-- ══ Data Sent Counter ══ -->
            <TextBlock Grid.Row="8" x:Name="BytesLabel"
                       Text="Data Sent: —"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="#3B82F6" FontSize="11"
                       FontWeight="SemiBold"/>

            <!-- ══ Auto-Start Checkbox ══ -->
            <CheckBox Grid.Row="9" x:Name="AutoStartCheckBox"
                      Content="Run at Windows Startup"
                      HorizontalAlignment="Center" FontSize="12"
                      Foreground="#94A3B8"
                      Click="AutoStartCheckBox_Click"/>
        </Grid>
    </Border>
</Window>
